<Project Sdk="Microsoft.NET.Sdk">
  <!-- Roda o TA.Core e os testes EditMode puros sem abrir o Unity (segundos em vez de minutos). Copia do coretests do Dungeon Courier.
       Mesmos arquivos do Unity; LangVersion 9 = o C# do Unity 6. Uso (da raiz do repo): dotnet test client/tools/coretests -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/_TA/Scripts/Core/**/*.cs" />
    <Compile Include="../../Assets/_TA/Tests/EditMode/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
