<Project>
  <!-- Verificacao rapida sem abrir o Unity (copia do viewcheck do Dungeon Courier): compila o Core das fontes e a View contra as DLLs
       do Unity 6000.3.27f1. Fase A: a View so usa o UnityEngine, entao nao precisa de client/Library. Quando entrar o uGUI ou o Input
       System, acrescente aqui as DLLs de client/Library/ScriptAssemblies (e a checagem delas no verify.sh), como no DC.
       Uso: dotnet build client/tools/viewcheck/view -nologo -v q   -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UnityManaged>C:\Program Files\Unity\Hub\Editor\6000.3.27f1\Editor\Data\Managed</UnityManaged>
    <ProjClient>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))</ProjClient>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(UnityManaged)\UnityEngine\*.dll" Exclude="$(UnityManaged)\UnityEngine\UnityEditor.*.dll" Private="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)core\TA.Core.csproj" />
  </ItemGroup>
</Project>
