<Project>
  <!-- Verificacao rapida sem abrir o Unity (copia do viewcheck do Dungeon Courier): compila o Core das fontes e a View contra as DLLs
       do Unity 6000.3.27f1. UnityEngine.UI (uGUI) vem de client/Library/ScriptAssemblies: o verify.sh acha a de outro worktree e passa em UguiDll;
       sem nenhuma, abra o projeto no Unity 1 vez (o verify.sh full abre). O Input System entra quando a View usar.
       Uso: dotnet build client/tools/viewcheck/view -nologo -v q   -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UnityManaged>C:\Program Files\Unity\Hub\Editor\6000.3.27f1\Editor\Data\Managed</UnityManaged>
    <ProjClient>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))</ProjClient>
    <UguiDll Condition="'$(UguiDll)' == ''">$(ProjClient)\Library\ScriptAssemblies\UnityEngine.UI.dll</UguiDll>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(UnityManaged)\UnityEngine\*.dll" Exclude="$(UnityManaged)\UnityEngine\UnityEditor.*.dll" Private="false" />
    <Reference Include="$(UguiDll)" Private="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)core\TA.Core.csproj" />
  </ItemGroup>
</Project>
